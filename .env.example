# =============================================================================
# Modèle du `.env` d'une passerelle. Le `.env` RÉEL n'est jamais versionné :
# il porte le secret d'agent, tiré de Vault au provisionnement (annexe 3
# §2.4) et propre à ce nœud.
#
# Renseigné par `provisionnement/preparer.sh`, jamais à la main.
# =============================================================================

# Identité du nœud, telle que déclarée à l'app de gestion (§6.1)
GW_ID=gw-01
DOMAINE=smartbureau.example

# Interfaces de sortie publique — celles que traverse l'internet
# centralisé des kits autorisés. Au conteneur `wireguard` seul, puisque
# l'agent de passerelle ne pose aucune règle (arbitrage Q10).
IFACES_PUBLIQUES=eth0

# wg-core : l'adresse /32 ALLOUÉE par l'app (§6.1, arbitrage D4) et
# l'endpoint du serveur. La paire de clés, elle, naît sur le nœud.
WG_CORE_ADRESSE=10.100.0.2/32
SERVEUR_ENDPOINT=203.0.113.1:51821
SERVEUR_CLE_PUBLIQUE=

# Secret de l'agent de passerelle — REMIS UNE FOIS à la déclaration
# (§6.1), tiré de Vault.
AGENT_SECRET=

# Images : par condensat en production (le `release.env` de la release les
# fixe). Jamais de tag mobile.
IMG_WG=consultom/wg:dev
IMG_WG_AGENT=consultom/wg-agent:dev
IMG_PROXY_ENROLEMENT=consultom/proxy-enrolement:dev
